##############
# BASE ENV VAR
##############
REMOTE_PROJECT_ROOT=/opt/home-lab
NETWORKS_NAME=swarm_networks
CONTAINER_CMD="python3 -m jupyterlab --config=/.jupyter/jupyter_server_config.py"

##################
# JUPYTER NOTEBOOK
##################
NOTEBOOK_WORKING_DIR=/opt/home-lab/workspace
SOURCE_CODE=/opt/home-lab/repo_process
NOTEBOOK_PORT=8888
NOTEBOOK_PORT_PUBLISHED=8888
